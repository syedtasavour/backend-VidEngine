# VidEngine — copy to .env and fill in, then `docker compose up --build`.
#
#   cp .env.example .env
#
# Docker Compose reads this file from the repository root. Everything below has
# a working default except the JWT secrets and the Cloudinary keys, which have
# no sensible default and must be set.

# ---------------------------------------------------------------------------
# Ports on your machine
# ---------------------------------------------------------------------------

# Open the app here: http://localhost:3000
# The web client is served on this port and proxies /api to the backend, so
# this single port is all you need.
APP_PORT=3000

# The API, exposed directly for Postman or curl: http://localhost:8000/api/v1
BACKEND_PORT=8000

# MongoDB, bound to 127.0.0.1 only — for Compass or mongosh.
MONGO_PORT=27017

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------

# The app appends /VidEngine to this value, so do NOT include a database name
# or a trailing slash. `mongo` is the Compose service; leave it as-is to use
# the bundled database.
#
# For MongoDB Atlas instead:
#   MONGODB_URI=mongodb+srv://user:password@cluster0.abcde.mongodb.net
MONGODB_URI=mongodb://mongo:27017

# ---------------------------------------------------------------------------
# Authentication — REQUIRED
# ---------------------------------------------------------------------------

# Any long random strings. Generate them with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Note the spelling: the backend reads ACESS_TOKEN_* (one S), not ACCESS_.
ACESS_TOKEN_SECRET=replace-me-with-a-long-random-string
ACESS_TOKEN_EXPIRY=1d
REFRESH_TOKEN_SECRET=replace-me-with-another-long-random-string
REFRESH_TOKEN_EXPIRY=10d

# ---------------------------------------------------------------------------
# Cloudinary — REQUIRED for video and image uploads
# ---------------------------------------------------------------------------

# From your Cloudinary dashboard: https://console.cloudinary.com
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# ---------------------------------------------------------------------------
# Advanced (defaults are fine)
# ---------------------------------------------------------------------------

# Only matters if the browser calls the API cross-origin. With the bundled
# setup everything is same-origin through the frontend proxy.
CORS_ORIGIN=http://localhost:3000

# Baked into the frontend bundle at build time. Keep it relative to stay
# same-origin; point it at an absolute URL only when the API lives elsewhere.
VITE_API_BASE_URL=/api/v1
